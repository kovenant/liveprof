{
    "name": "kovenant/liveprof",
    "type": "library",
    "description": "A performance monitoring system for running on live sites (a fork of badoo/liveprof for PHP 8)",
    "homepage": "https://github.com/kovenant/liveprof",
    "license": "MIT",
    "authors": [
        {
            "name": "Badoo Development"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "doctrine/dbal": "^2.13 || ^3.0 || ^4.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "suggest": {
        "ext-xhprof": "To profile with the xhprof extension",
        "ext-tideways_xhprof": "To profile with the Tideways XHProf extension"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.5"
    },
    "autoload": {
        "psr-4": {
            "Badoo\\LiveProfiler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Badoo\\LiveProfiler\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "phpunit": "phpunit",
        "coverage": "XDEBUG_MODE=coverage phpunit --coverage-text --coverage-filter src",
        "cs-fix": "php-cs-fixer fix -vvv",
        "cs-view": "@cs-fix --dry-run --diff",
        "phpstan": "phpstan analyse",
        "test": [
            "@cs-view",
            "@phpstan",
            "@phpunit"
        ]
    }
}
